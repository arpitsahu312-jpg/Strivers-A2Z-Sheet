#include<bits/stdc++.h>
using namespace std;

//loops are for performing a tash repeatedly

int main()
{
    for(int i=1;i<=10;i++)
    {
        cout<<"Striver"<<endl;
    }

    int i=0;
    while(i<=5)
    {
    cout<<"Striver "<<i<<endl;
    i++;
    }    

    int i=2;
    do
    {
      cout<<"Striver "<<i<<endl;
      i++;
    } 
    while (i<=1);
    cout<<i<<endl;
    return 0;
}